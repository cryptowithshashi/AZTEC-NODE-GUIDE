# --- Required for ALL Node Types ---

# L1 Execution Client (EL) RPC URL (e.g., Alchemy, Infura Sepolia endpoint)
# Example: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY


ETHEREUM_HOSTS=

# L1 Consensus Client (CL) RPC URL (e.g., DRPC, QuickNode Sepolia endpoint)
# Example: https://lb.drpc.org/ogrpc?network=sepolia&dkey=YOUR_DRPC_API_KEY


L1_CONSENSUS_HOST_URLS=

# Your public IP address (used for P2P discovery). The setup script attempts to fetch this automatically.
# If running behind NAT/firewall, ensure port 40400 (TCP/UDP) is forwarded.
# Example: 93.184.216.34


P2P_IP=

# --- Required for Full Node & Sequencer Node ---
# Private key for the validator identity (used for signing blocks).
# Generate a NEW key for this purpose. DO NOT USE A KEY HOLDING MAINNET ASSETS.
# Example: 0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa


VALIDATOR_PRIVATE_KEY=

# Ethereum address corresponding to the VALIDATOR_PRIVATE_KEY (where block rewards go).
# Example: 0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb


VALIDATOR_COINBASE=

# --- Optional for Full Node & Sequencer Node ---
# URL for a blob sink service to reduce load on your CL endpoint.
# Example: https://your-blob-sink-provider.com/api


BLOB_SINK_URL=

# --- Required for Prover Node ---
# Private key used by the Prover Node to publish proofs to L1.
# Generate a NEW key.
# Example: 0xcccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc


PROVER_PUBLISHER_PRIVATE_KEY=

# Ethereum address corresponding to PROVER_PUBLISHER_PRIVATE_KEY. This is the Prover's ID.
# Example: 0xdddddddddddddddddddddddddddddddddddddddd


PROVER_ID=

# --- Optional Configuration ---
# Data directory for node state (relative path used in docker-compose)
DATA_DIRECTORY="/data"

# Log level (e.g., trace, debug, info, warn, error)
LOG_LEVEL="info"

# Aztec Network to connect to
AZTEC_NETWORK="alpha-testnet"

# Docker Image Tag (ensure this matches the version you intend to run)
AZTEC_DOCKER_IMAGE_TAG="aztecprotocol/aztec:0.85.0-alpha-testnet.5"

# Max transaction pool size for Sequencer/Full Node
# P2P_MAX_TX_POOL_SIZE="1000000000" # Example value from docs

# Prover Agent configuration (for prover-node)
# PROVER_AGENT_COUNT="1"
# PROVER_AGENT_POLL_INTERVAL_MS="10000"

